# Скопируйте в .env при необходимости. Демо полностью работает и без этого файла.
#
# fixture (по умолчанию) — офлайн, детерминированно, ключ не нужен.
# live — реальные вызовы LLM через OpenRouter, требуется OPENROUTER_API_KEY.
LLM_MODE=fixture

# LLM-провайдер. По умолчанию — OpenRouter (OpenAI-совместимый API).
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Одна модель на агента и оба нарратора (blind/grounded) — как в сиблинге
# explainable-ai; различие только во входе, не в модели (эскиз §4, §12.6).
NARRATOR_MODEL=moonshotai/kimi-k2

# Порог разрыва верности для CI-guard (эскиз §12.5).
CI_GAP_THRESHOLD=25

# Проставляется CI из git rev-parse HEAD; локально можно не трогать.
CODE_VERSION=dev
